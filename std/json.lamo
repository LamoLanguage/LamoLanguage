// std.json — JSON parsing and serialization.
//
// Part of the Lamo standard library. A pure-Lamo JSON parser and
// serializer.
//
// Representation:
//   - JSON object  -> a 2-element array: [keys_array, values_array]
//   - JSON array   -> a Lamo array
//   - JSON string  -> a Lamo string
//   - JSON number  -> Lamo int (or string for floats; Lamo can't yet
//                     parse float-from-string, so floats stay as strings)
//   - JSON true    -> Lamo int 1
//   - JSON false   -> Lamo int 0
//   - JSON null    -> Lamo int -1 (sentinel)
//
// The parser uses a mutable state array `[text, pos]` so that recursive
// parse functions can advance the position without needing multiple
// return values (which Lamo doesn't support).
//
// Usage:
//   import std.json as json
//   let v = json.parse("{\"name\":\"lamo\",\"version\":1}")
//   print(json.getString(v, "name"))   // "lamo"
//   print(json.getInt(v, "version"))   // 1

let _NULL_SENTINEL = -1

// ─── Parser helpers (all take a state [text, pos] and mutate state[1]) ──

fn _peek(state) {
    let text = state[0]
    let pos = state[1]
    if (pos < __lamo_std_str_length(text)) {
        return __lamo_std_str_char_at(text, pos)
    }
    return ""
}

fn _advance(state) {
    state[1] = state[1] + 1
    return 0
}

fn _skipWhitespace(state) {
    let text = state[0]
    while (state[1] < __lamo_std_str_length(text)) {
        let c = __lamo_std_str_char_at(text, state[1])
        if (c == " " || c == "\t" || c == "\n" || c == "\r") {
            state[1] = state[1] + 1
        } else {
            break
        }
    }
    return 0
}

fn _isDigit(c) {
    if (c == "0") { return 1 }
    if (c == "1") { return 1 }
    if (c == "2") { return 1 }
    if (c == "3") { return 1 }
    if (c == "4") { return 1 }
    if (c == "5") { return 1 }
    if (c == "6") { return 1 }
    if (c == "7") { return 1 }
    if (c == "8") { return 1 }
    if (c == "9") { return 1 }
    return 0
}

fn _isNumberChar(c) {
    if (_isDigit(c)) { return 1 }
    if (c == "-") { return 1 }
    if (c == "+") { return 1 }
    if (c == ".") { return 1 }
    if (c == "e") { return 1 }
    if (c == "E") { return 1 }
    return 0
}

fn _digitToInt(c) {
    if (c == "0") { return 0 }
    if (c == "1") { return 1 }
    if (c == "2") { return 2 }
    if (c == "3") { return 3 }
    if (c == "4") { return 4 }
    if (c == "5") { return 5 }
    if (c == "6") { return 6 }
    if (c == "7") { return 7 }
    if (c == "8") { return 8 }
    if (c == "9") { return 9 }
    return 0
}

fn _isFloat(s) {
    if (__lamo_std_str_contains(s, ".")) { return 1 }
    if (__lamo_std_str_contains(s, "e")) { return 1 }
    if (__lamo_std_str_contains(s, "E")) { return 1 }
    return 0
}

fn _parseInt(s) {
    let n = __lamo_std_str_length(s)
    if (n == 0) { return 0 }
    let i = 0
    let sign = 1
    if (__lamo_std_str_char_at(s, 0) == "-") {
        sign = -1
        i = 1
    } else if (__lamo_std_str_char_at(s, 0) == "+") {
        i = 1
    }
    let value = 0
    while (i < n) {
        let c = __lamo_std_str_char_at(s, i)
        let digit = _digitToInt(c)
        value = value * 10 + digit
        i = i + 1
    }
    return value * sign
}

fn _parseValue(state) {
    _skipWhitespace(state)
    let c = _peek(state)
    if (c == "{") { return _parseObject(state) }
    if (c == "[") { return _parseArray(state) }
    if (c == "\"") { return _parseString(state) }
    if (c == "t" || c == "f") { return _parseBool(state) }
    if (c == "n") { return _parseNull(state) }
    return _parseNumber(state)
}

fn _parseObject(state) {
    _advance(state)  // skip '{'
    let ks = []
    let vs = []
    _skipWhitespace(state)
    if (_peek(state) == "}") {
        _advance(state)
        return [ks, vs]
    }
    while (true) {
        _skipWhitespace(state)
        let key = _parseString(state)
        _skipWhitespace(state)
        _advance(state)  // skip ':'
        let value = _parseValue(state)
        push(ks, key)
        push(vs, value)
        _skipWhitespace(state)
        let c = _peek(state)
        if (c == "}") {
            _advance(state)
            break
        }
        if (c == ",") {
            _advance(state)
        } else {
            break
        }
    }
    return [ks, vs]
}

fn _parseArray(state) {
    _advance(state)  // skip '['
    let arr = []
    _skipWhitespace(state)
    if (_peek(state) == "]") {
        _advance(state)
        return arr
    }
    while (true) {
        let value = _parseValue(state)
        push(arr, value)
        _skipWhitespace(state)
        let c = _peek(state)
        if (c == "]") {
            _advance(state)
            break
        }
        if (c == ",") {
            _advance(state)
        } else {
            break
        }
    }
    return arr
}

fn _parseString(state) {
    _advance(state)  // skip opening quote
    let text = state[0]
    let result = ""
    while (state[1] < __lamo_std_str_length(text)) {
        let c = __lamo_std_str_char_at(text, state[1])
        if (c == "\"") {
            _advance(state)
            return result
        }
        if (c == "\\") {
            _advance(state)
            let esc = __lamo_std_str_char_at(text, state[1])
            if (esc == "n") { result = result + "\n" }
            else if (esc == "t") { result = result + "\t" }
            else if (esc == "r") { result = result + "\r" }
            else if (esc == "\"") { result = result + "\"" }
            else if (esc == "\\") { result = result + "\\" }
            else if (esc == "/") { result = result + "/" }
            else { result = result + esc }
            _advance(state)
        } else {
            result = result + c
            _advance(state)
        }
    }
    return result
}

fn _parseNumber(state) {
    let text = state[0]
    let start = state[1]
    while (state[1] < __lamo_std_str_length(text)) {
        let c = __lamo_std_str_char_at(text, state[1])
        if (_isNumberChar(c)) {
            state[1] = state[1] + 1
        } else {
            break
        }
    }
    let s = __lamo_std_str_substring(text, start, state[1])
    if (_isFloat(s)) {
        return s
    }
    return _parseInt(s)
}

fn _parseBool(state) {
    let text = state[0]
    let rest = __lamo_std_str_substring(text, state[1], -1)
    if (__lamo_std_str_starts_with(rest, "true")) {
        state[1] = state[1] + 4
        return 1
    }
    if (__lamo_std_str_starts_with(rest, "false")) {
        state[1] = state[1] + 5
        return 0
    }
    return 0
}

fn _parseNull(state) {
    let text = state[0]
    let rest = __lamo_std_str_substring(text, state[1], -1)
    if (__lamo_std_str_starts_with(rest, "null")) {
        state[1] = state[1] + 4
    }
    return _NULL_SENTINEL
}

// parse(text) — parse a JSON string into Lamo values.
fn parse(text) {
    let state = [text, 0]
    return _parseValue(state)
}

// ─── Object access helpers ───────────────────────────────────────────
// Objects are represented as [keys_array, values_array]. These helpers
// hide that representation from the user.

fn _findKey(obj, key) {
    let ks = obj[0]
    let i = 0
    while (i < ks.len()) {
        if (ks[i] == key) { return i }
        i = i + 1
    }
    return -1
}

fn get(obj, key) {
    let i = _findKey(obj, key)
    if (i < 0) { return _NULL_SENTINEL }
    let vs = obj[1]
    return vs[i]
}

fn getString(obj, key) {
    return get(obj, key)
}

fn getInt(obj, key) {
    return get(obj, key)
}

fn has(obj, key) {
    if (_findKey(obj, key) < 0) { return 0 }
    return 1
}

fn keys(obj) {
    return obj[0]
}

fn values(obj) {
    return obj[1]
}

fn len(obj) {
    let ks = obj[0]
    return ks.len()
}

// ─── Stringify ───────────────────────────────────────────────────────

fn stringify(value) {
    return _stringifyValue(value)
}

fn _isJsonObject(value) {
    if (isarray(value) == 0) { return 0 }
    if (value.len() != 2) { return 0 }
    if (isarray(value[0]) == 0) { return 0 }
    if (isarray(value[1]) == 0) { return 0 }
    return 1
}

fn _stringifyValue(value) {
    if (isstring(value)) {
        return _stringifyString(value)
    }
    if (isnumber(value)) {
        return value + ""
    }
    if (_isJsonObject(value)) {
        let ks = value[0]
        let vs = value[1]
        let result = "{"
        let i = 0
        let n = ks.len()
        while (i < n) {
            if (i > 0) { result = result + "," }
            result = result + _stringifyString(ks[i])
            result = result + ":"
            result = result + _stringifyValue(vs[i])
            i = i + 1
        }
        result = result + "}"
        return result
    }
    if (isarray(value)) {
        let result = "["
        let i = 0
        let n = value.len()
        while (i < n) {
            if (i > 0) { result = result + "," }
            result = result + _stringifyValue(value[i])
            i = i + 1
        }
        result = result + "]"
        return result
    }
    return "null"
}

fn _stringifyString(s) {
    let result = "\""
    let i = 0
    let n = __lamo_std_str_length(s)
    while (i < n) {
        let c = __lamo_std_str_char_at(s, i)
        if (c == "\"") { result = result + "\\\"" }
        else if (c == "\\") { result = result + "\\\\" }
        else if (c == "\n") { result = result + "\\n" }
        else if (c == "\t") { result = result + "\\t" }
        else if (c == "\r") { result = result + "\\r" }
        else { result = result + c }
        i = i + 1
    }
    result = result + "\""
    return result
}
