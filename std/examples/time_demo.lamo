import std.time as time
import std.io as io

io.println("now (ms since epoch): " + time.now())
io.println("timestamp (s):        " + time.timestamp())

let start = time.monotonic()
let sum = 0
let i = 0
while (i < 100000) {
    sum = sum + i
    i = i + 1
}
let elapsed = time.monotonic() - start
io.println("Computed sum = " + sum)
io.println("Elapsed: " + elapsed + "ms")

io.println("Sleeping 50ms...")
time.sleep(50)
io.println("Done sleeping.")
