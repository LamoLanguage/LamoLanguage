// std.env — Environment variable access.
//
// Part of the Lamo standard library. Wraps the C-level env builtins
// (getenv, setenv, unsetenv). Cross-platform (Win32 + POSIX).
//
// Usage:
//   import std.env as env
//   let path = env.get("PATH")
//   env.set("LAMO_VERBOSE", "1")
//   env.remove("TEMP_VAR")

fn get(name) {
    return __lamo_std_env_get(name)
}

fn set(name, value) {
    return __lamo_std_env_set(name, value)
}

fn remove(name) {
    return __lamo_std_env_remove(name)
}

// has(name) — returns 1 if an environment variable with the given name
// is set (even if empty), 0 otherwise.
fn has(name) {
    let v = __lamo_std_env_get(name)
    if (v == "") { return 0 }
    return 1
}

// getOr(name, default) — return the named variable, or `default` if
// it's unset (i.e. empty).
fn getOr(name, default) {
    let v = __lamo_std_env_get(name)
    if (v == "") { return default }
    return v
}
