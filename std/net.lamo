// std.net — Networking (HTTP client).
//
// Part of the Lamo standard library. Provides simple blocking HTTP
// client functions. The first version supports plain HTTP (no TLS);
// HTTPS support is planned for a future release (it requires linking
// against a TLS library, which the language doesn't do yet).
//
// Both functions block until the response is fully received. Returns
// the response body as a string. On network or parsing errors, returns
// an empty string.
//
// Usage:
//   import std.net as net
//   let body = net.get("http://example.com/")
//   print(body)
//   let r = net.post("http://httpbin.org/post", "hello=world")

// get(url) — issue an HTTP GET and return the response body.
fn get(url) {
    return __lamo_std_net_http_get(url)
}

// post(url, body) — issue an HTTP POST with the given body and return
// the response body. The Content-Type is "text/plain".
fn post(url, body) {
    return __lamo_std_net_http_post(url, body)
}

// httpGet(url) — explicit alias for get(url).
fn httpGet(url) {
    return __lamo_std_net_http_get(url)
}

// httpPost(url, body) — explicit alias for post(url, body).
fn httpPost(url, body) {
    return __lamo_std_net_http_post(url, body)
}
