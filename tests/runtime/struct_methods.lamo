struct Point {
    x: int,
    y: int
}

impl Point {
    fn magnitude_squared() {
        return self.x * self.x + self.y * self.y
    }
    fn translate(dx: int, dy: int) {
        self.x += dx
        self.y += dy
    }
}

let p = Point { x: 3, y: 4 };
print(p.magnitude_squared());

p.translate(1, 1);
print(p.x);
print(p.y);
print(p.magnitude_squared());

let q = Point { x: 5, y: 12 };
print(q.magnitude_squared());
